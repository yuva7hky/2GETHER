# 2GETHER Server Environment Configuration
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Supabase Configuration (Optional for offline dev mock mode)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Cloudflare R2 / S3-Compatible Storage Configuration
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=2gether-movies
R2_PUBLIC_DOMAIN=https://movies.yourdomain.com
